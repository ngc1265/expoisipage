{
  "$schema": "https://railway.app/railway.schema.json",

  "build": {
    "builder": "NIXPACKS"
  },

  "deploy": {
    "startCommand": "node migrar.js && node servidor.js",
    "healthcheckPath": "/salud",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
